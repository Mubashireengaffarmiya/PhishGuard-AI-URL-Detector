# PhishGuard AI - Environment Configuration Example
# Copy this file to .env and configure as needed.

# Threat Intelligence Settings
# External reputation lookup (e.g. VirusTotal API)
REPUTATION_API_KEY=
THREAT_INTEL_ENABLED=false

# Network Probing Settings (Passive DNS, WHOIS, SSL inspection)
# Set to false if working completely offline or in restricted environments
DNS_ENABLED=true
WHOIS_ENABLED=true
SSL_ENABLED=true
NETWORK_TIMEOUT_SECONDS=3

# Application Settings
LOG_LEVEL=INFO
APP_PORT=8501
